config_version=5

[application]

config/name="Endless Stars"
run/main_scene="uid://c5htme08v5rox"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://cexb4qmpnjy5b"
config/icon="uid://b2xq115nyruom"
